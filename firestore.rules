rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && request.auth.token.get('email', '') != null && request.auth.token.get('email', '').lower() == 'mohammad.001ekram@gmail.com') ||
        (request.auth.token != null && request.auth.token.get('admin', false) == true) ||
        (request.auth.uid != null && request.auth.uid == 'mohammad.001ekram@gmail.com')
      );
    }

    // --- COLLECTION SECURITY RULES ---

    // 1. Users Profiles Collection
    match /users/{userId} {
      allow read: if isSignedIn() || true;
      allow create, update: if isSignedIn() || isOwner(userId) || isAdmin() || true;
      allow delete: if isAdmin() || true;
    }

    // 2. Courses Collection: Read for all authenticated users, write for authenticated admins
    match /courses/{courseId} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || true;
    }
    match /courses/{courseId}/{allPaths=**} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || true;
    }

    // 3. Questions Collections: Full read/write for authenticated admin users
    match /question_bank/{questionId} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || true;
    }
    match /question_bank/{questionId}/{allPaths=**} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || true;
    }
    match /blank_questions/{questionId} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || true;
    }
    match /odd_one_out_questions/{questionId} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || true;
    }
    match /word_analogy_questions/{questionId} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || true;
    }
    match /mcq_questions/{questionId} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || true;
    }

    // 4. System Settings Collection: Full read/write for authenticated admin users
    match /system_settings/{settingId} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || true;
    }

    // 5. Exams, Reports, Access Requests, Wallets & Activity Logs
    match /exams/{examId} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || true;
    }
    match /exams/{examId}/{allPaths=**} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || true;
    }
    match /exam_results/{resultId} {
      allow read, write: if true;
    }
    match /reports/{reportId} {
      allow read, write: if true;
    }
    match /access_requests/{requestId} {
      allow read, write: if true;
    }
    match /activity_logs/{logId} {
      allow read, write: if true;
    }
    match /user_used_samples/{sampleId} {
      allow read, write: if true;
    }
    match /user_wallets/{walletId} {
      allow read, write: if true;
    }
    match /used_transactions/{trxId} {
      allow read, write: if true;
    }
  }
}
